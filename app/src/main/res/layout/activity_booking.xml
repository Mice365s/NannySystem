<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAECD9"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvBookingNannyName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Booking Request for: Nanny"
        android:textColor="#A06A3B"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Date (e.g., 2026-10-15):"
        android:textColor="#000000" />

    <EditText
        android:id="@+id/etBookingDate"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@android:drawable/editbox_background_normal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:padding="12dp"
        android:textColor="#000000" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Time (e.g., 08:00 AM):"
        android:textColor="#000000" />

    <EditText
        android:id="@+id/etBookingTime"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@android:drawable/editbox_background_normal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="32dp"
        android:padding="12dp"
        android:textColor="#000000" />

    <Button
        android:id="@+id/btnConfirmBooking"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:backgroundTint="#3A8F46"
        android:text="Confirm Booking"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tvCancelBooking"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cancel"
        android:textColor="#D32F2F"
        android:textStyle="bold"
        android:layout_gravity="center"
        android:padding="8dp"/>

</LinearLayout>