<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAECD9"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvPaymentHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Complete Payment"
        android:textColor="#A06A3B"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Card Number:"
        android:textColor="#000000" />

    <EditText
        android:id="@+id/etCardNumber"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@android:drawable/editbox_background_normal"
        android:hint="1234 5678 9101 1121"
        android:inputType="number"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:padding="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="32dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Expiry Date:"
                android:textColor="#000000" />

            <EditText
                android:id="@+id/etExpiry"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@android:drawable/editbox_background_normal"
                android:hint="MM/YY"
                android:layout_marginTop="8dp"
                android:padding="12dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CVV:"
                android:textColor="#000000" />

            <EditText
                android:id="@+id/etCvv"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@android:drawable/editbox_background_normal"
                android:hint="123"
                android:inputType="numberPassword"
                android:layout_marginTop="8dp"
                android:padding="12dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- NEW RATING BAR SECTION -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Rate this Nanny:"
        android:textAlignment="center"
        android:textColor="#000000"
        android:textStyle="bold"
        android:layout_marginTop="8dp"/>

    <RatingBar
        android:id="@+id/rbNannyRating"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="24dp"
        android:numStars="5"
        android:stepSize="1.0"
        android:progressTint="#FFC107" />

    <Button
        android:id="@+id/btnSubmitPayment"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:backgroundTint="#3A8F46"
        android:text="Process Payment"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tvCancelPayment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cancel"
        android:textColor="#D32F2F"
        android:textStyle="bold"
        android:layout_gravity="center"
        android:padding="8dp"/>

</LinearLayout>